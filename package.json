{
  "name": "petal-elements",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Community-maintained Material 3 Expressive web components. Not an official Google project.",
  "keywords": [
    "material 3",
    "material 3 expressive",
    "m3",
    "design system",
    "components",
    "web components",
    "lit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saki340/petal-elements.git"
  },
  "license": "Apache-2.0",
  "author": "Saki",
  "bugs": {
    "url": "https://github.com/Saki340/petal-elements/issues"
  },
  "homepage": "https://github.com/Saki340/petal-elements#readme",
  "scripts": {
    "build": "wireit",
    "build:ts": "wireit",
    "build:css-to-ts": "wireit",
    "build:sass": "wireit",
    "build:manifest": "wireit",
    "test": "wireit",
    "build:catalog": "wireit",
    "build:scripts": "wireit",
    "update-docs": "wireit",
    "update-docs:components": "wireit",
    "update-docs:sass-ext": "wireit",
    "update-size": "wireit",
    "check:licenses": "wireit",
    "check:rebrand": "wireit",
    "tokens": "wireit",
    "check:tokens": "wireit",
    "tokens:upstream": "wireit",
    "test:visual": "wireit",
    "docs:images": "wireit",
    "build:landing": "wireit",
    "build:site": "wireit",
    "update-docs:llms": "wireit"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "files": [
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts",
    "**/*.scss",
    "**/*.css",
    "**/*.css.map",
    "custom-elements.json",
    "llms.txt",
    "llms-full.txt",
    "CHANGELOG.md",
    "docs/**/*.md",
    "migrations/**/*.md",
    "NOTICE",
    "tokens/sources.json",
    "tokens/dtcg/web/*.tokens.json",
    "!web-test-runner.config.js",
    "!commitlint.config.js",
    "!**/test/**",
    "!**/*_test.*",
    "!.wireit/**",
    "!.cache/**",
    "!catalog/",
    "!landing/",
    "!_site/",
    "!scripts/",
    "!**/testing/**",
    "testing/harness.{js,js.map,d.ts}",
    "testing/transform-pseudo-classes.{js,js.map,d.ts}",
    "!tests/**"
  ],
  "workspaces": [
    "catalog"
  ],
  "dependencies": {
    "@lit/context": "^1.1.6",
    "lit": "^2.8.0 || ^3.0.0",
    "safevalues": "^1.2.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@lit-labs/analyzer": "^0.14.0",
    "@lit-labs/gen-manifest": "^0.3.6",
    "@lit-labs/gen-utils": "^0.3.4",
    "@material/material-color-utilities": "0.2.7",
    "@playwright/test": "1.56.1",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jasmine": "^4.0.3",
    "@types/node": "^24.10.1",
    "@web/test-runner": "^0.18.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "element-internals-polyfill": "^1.3.12",
    "jasmine": "^4.5.0",
    "material-symbols": "0.47.6",
    "playwright": "^1.49.0",
    "rollup": "^2.79.1",
    "sass": "^1.93.2",
    "sass-true": "^6.1.0",
    "style-dictionary": "^5.5.5",
    "typescript": "5.9.2",
    "web-test-runner-jasmine": "^0.0.6",
    "wireit": "^0.14.12"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:ts",
        "build:manifest"
      ]
    },
    "build:ts": {
      "dependencies": [
        "build:ts:main"
      ]
    },
    "build:ts:main": {
      "command": "tsc --pretty",
      "files": [
        "tsconfig.json",
        "tsconfig.base.json",
        "**/*.ts",
        "!**/*.d.ts",
        "!**/*.cssresult.ts",
        "!catalog/",
        "!landing/",
        "!_site/",
        "!scripts/",
        "!.claude/**"
      ],
      "output": [
        ".tsbuildinfo",
        "**/*.js",
        "**/*.js.map",
        "**/*.d.ts",
        "!web-test-runner.config.js",
        "!commitlint.config.js",
        "!types/",
        "!catalog/",
        "!landing/",
        "!_site/",
        "!scripts/",
        "!.claude/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "build:css-to-ts"
      ]
    },
    "build:css-to-ts": {
      "command": "node scripts/build-tasks.js css-to-ts",
      "files": [
        "**/*.css",
        "!catalog/",
        "!.claude/**"
      ],
      "output": [
        "**/*.cssresult.ts",
        "!catalog/",
        "!.claude/**"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "build:scripts",
        "build:sass"
      ]
    },
    "build:sass": {
      "command": "node scripts/build-tasks.js sass",
      "files": [
        "**/*.scss",
        "!catalog/",
        "!.claude/**"
      ],
      "output": [
        "**/*.css",
        "**/*.css.map",
        "!catalog/",
        "!landing/",
        "!_site/",
        "!tokens/css/**",
        "!.claude/**"
      ],
      "dependencies": [
        "build:sass:generate"
      ]
    },
    "build:sass:generate": {
      "command": "node scripts/build-tasks.js sass-meta",
      "files": [
        "tokens/versions/**/_md-*.scss",
        "!tokens/versions/**/*-meta.scss"
      ],
      "output": [
        "tokens/versions/**/*-meta.scss"
      ],
      "dependencies": [
        "build:scripts"
      ]
    },
    "build:manifest": {
      "command": "node scripts/analyzer/generate-manifest.js",
      "files": [
        "**/*.ts",
        "!.claude/**"
      ],
      "output": [
        "custom-elements.json"
      ],
      "dependencies": [
        "build:scripts",
        "build:ts"
      ]
    },
    "test": {
      "command": "wtr",
      "dependencies": [
        "build:ts"
      ],
      "files": [
        "web-test-runner.config.js"
      ],
      "output": []
    },
    "build:catalog": {
      "dependencies": [
        "./catalog:build:prod"
      ]
    },
    "build:scripts": {
      "command": "tsc -b scripts/tsconfig.json --pretty",
      "files": [
        "scripts/tsconfig.json",
        "scripts/**/*.ts",
        "!**/*.d.ts"
      ],
      "output": [
        "scripts/.tsbuildinfo",
        "scripts/**/*.js",
        "scripts/**/*.js.map",
        "scripts/**/*.d.ts"
      ],
      "clean": "if-file-deleted"
    },
    "update-docs": {
      "dependencies": [
        "update-docs:components",
        "update-docs:sass-ext",
        "update-docs:llms"
      ]
    },
    "update-docs:components": {
      "command": "node scripts/analyzer/update-docs.js",
      "files": [
        "docs/components/*.md",
        "**/*.ts",
        "!**/*.d.ts",
        "!**/*.cssresult.ts",
        "!catalog/",
        "!scripts/",
        "scripts/analyzer/update-docs.js",
        "!.claude/**"
      ],
      "output": [],
      "dependencies": [
        "build:scripts"
      ]
    },
    "update-docs:sass-ext": {
      "command": "node scripts/update-sass-ext-docs.js --input=./sass/ext/ --output=./docs/sass/sass-ext.md",
      "files": [
        "docs/sass/sass-ext.md",
        "sass/ext/_*.scss",
        "!sass/ext/*_test.scss",
        "scripts/update-sass-ext-docs.js"
      ],
      "output": [],
      "dependencies": [
        "build:scripts"
      ]
    },
    "update-size": {
      "command": "node scripts/size/update-size.js",
      "dependencies": [
        "build:scripts",
        "build"
      ]
    },
    "check:licenses": {
      "command": "node scripts/check-licenses.js",
      "dependencies": [
        "build:scripts"
      ],
      "files": [
        "package-lock.json"
      ],
      "output": []
    },
    "check:rebrand": {
      "command": "node scripts/rebrand.js --check",
      "dependencies": [
        "build:scripts"
      ],
      "output": []
    },
    "tokens": {
      "command": "node scripts/tokens/build.js",
      "dependencies": [
        "build:scripts"
      ],
      "files": [
        "tokens/sources.json",
        "tokens/versions/latest/sass/**",
        "tokens/versions/v0_192/**",
        "!tokens/versions/**/*-meta.scss"
      ],
      "output": [
        "tokens/dtcg/**",
        "tokens/css/*.css",
        "tokens/reports/**"
      ],
      "clean": false
    },
    "check:tokens": {
      "command": "node scripts/tokens/build.js --check && node scripts/tokens/check-usage.js",
      "dependencies": [
        "build:scripts",
        "build:sass"
      ],
      "output": []
    },
    "tokens:upstream": {
      "command": "node scripts/tokens/upstream.js",
      "dependencies": [
        "build:scripts"
      ],
      "output": []
    },
    "test:visual": {
      "command": "playwright test -c tests/visual",
      "dependencies": [
        "build:ts",
        "build:scripts"
      ],
      "files": [
        "tests/visual/**",
        "!tests/visual/__screenshots__/**"
      ],
      "output": []
    },
    "docs:images": {
      "command": "node scripts/docs-images/render.js",
      "dependencies": [
        "build:ts",
        "build:scripts"
      ],
      "output": []
    },
    "build:landing": {
      "command": "node landing/build.mjs",
      "dependencies": [
        "build:ts",
        "update-docs:llms"
      ],
      "files": [
        "landing/**",
        "!landing/_site/**",
        "tokens/css/*.css",
        "llms.txt",
        "llms-full.txt"
      ],
      "output": [
        "landing/_site/**"
      ]
    },
    "build:site": {
      "command": "node landing/build.mjs --site",
      "dependencies": [
        "build:ts",
        "update-docs:llms"
      ],
      "output": []
    },
    "update-docs:llms": {
      "command": "node scripts/llms-full.js",
      "files": [
        "llms.txt",
        "docs/**/*.md",
        "scripts/llms-full.js"
      ],
      "output": [
        "llms-full.txt"
      ],
      "dependencies": [
        "update-docs:components",
        "build:scripts"
      ]
    }
  }
}
